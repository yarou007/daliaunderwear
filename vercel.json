{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/dalia-portal.js": { "includeFiles": "portal/**" }
  },
  "rewrites": [
    { "source": "/equipe/:slug/api/:route+", "destination": "/api/dalia-proxy?slug=:slug&route=:route" },
    { "source": "/equipe/:slug/:asset", "destination": "/api/dalia-portal?slug=:slug&asset=:asset" },
    { "source": "/equipe/:slug", "destination": "/api/dalia-portal?slug=:slug" },
    { "source": "/api/dalia/:route+", "destination": "/api/dalia-proxy?route=:route" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Referrer-Policy", "value": "same-origin" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
